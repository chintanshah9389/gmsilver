# ─────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# ─────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/gm_silver

# ─────────────────────────────────────────
# JWT
# ─────────────────────────────────────────
JWT_ACCESS_SECRET=your_super_secret_access_key_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─────────────────────────────────────────
# CLOUDFLARE R2
# ─────────────────────────────────────────
R2_ACCOUNT_ID=your_cloudflare_account_id
# Optional: use this instead of R2_ACCOUNT_ID when you have a full endpoint
# Example: https://<accountid>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=gm-silver
R2_PUBLIC_URL=https://pub-d2cf444026fd43efb28227dcb9671430.r2.dev

# ─────────────────────────────────────────
# FIREBASE
# ─────────────────────────────────────────
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"

# ─────────────────────────────────────────
# CORS
# ─────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,https://admin.gmsilver.com

# ─────────────────────────────────────────
# RATE LIMITING
# ─────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=60

# ─────────────────────────────────────────
# COMPANY (for invoices)
# ─────────────────────────────────────────
COMPANY_NAME=GM Silver
COMPANY_ADDRESS=Your Company Address
COMPANY_PHONE=+91-XXXXXXXXXX
COMPANY_EMAIL=info@gmsilver.com
COMPANY_GST=XXXXXXXXXXXX
